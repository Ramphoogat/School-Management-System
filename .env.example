DATABASE_URL=postgresql://school:school@localhost:5432/school
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
PORT=4000
# Set to "production" on a real server. The API then refuses to start with placeholder or short JWT secrets,
# a demo super admin password, or a localhost / http WEB_ORIGIN.
NODE_ENV=
# How many proxies (Nginx) sit in front of the API, normally 1. Lets the sign-in limiter see each visitor's real address.
# Leave empty if the API is reached directly (the forwarded address could be forged).
TRUST_PROXY=
# Sign-in protection (defaults shown). Wrong passwords allowed per email, and per network address, in the window.
# LOGIN_MAX_PER_EMAIL=10
# LOGIN_MAX_PER_IP=60
# LOGIN_WINDOW_MINUTES=15
WEB_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379

# Email (SMTP). Leave EMAIL_HOST empty to disable email sending.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# WhatsApp Business Cloud API. Requires a Meta-approved template with one body variable.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=school_notification
WHATSAPP_TEMPLATE_LANG=en

# Razorpay (fee payments). Leave empty to disable online payment; use test-mode keys while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signing secret you set when adding the webhook in the Razorpay dashboard
# (URL: https://YOUR-API-HOST/api/fees/razorpay/webhook, events: payment.captured, order.paid, refund.processed, refund.failed).
# Without it the webhook refuses every call.
RAZORPAY_WEBHOOK_SECRET=
# Set to "off" to stop the daily fee reminder job (for example on a second server).
FEE_REMINDERS=

# Where uploaded files (homework) are stored on disk. Back this folder up with the database.
UPLOAD_DIR=./uploads

# Optional virus scanning of every upload through a ClamAV daemon (clamd). Leave empty to skip scanning.
# When set, a file is stored only if ClamAV says it is clean, and uploads are refused while ClamAV is unreachable.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Multi-school. The platform's super admin is created at startup from these two settings, if none exists yet.
# It manages schools (create, suspend, add an admin) and never sees any school's own data. Use a strong password in production.
SUPERADMIN_EMAIL=superadmin@school.test
SUPERADMIN_PASSWORD=password123
# Optional. If schools get subdomains (greenfield.example.com), set the base domain here in the web app's environment (apps/web/.env).
# Without it a school's sign-in link is /?school=greenfield.
# VITE_BASE_DOMAIN=example.com

# File storage: leave S3_BUCKET empty to keep files in UPLOAD_DIR on this server.
# To use Amazon S3, Cloudflare R2, MinIO or similar, set the bucket and keys. See apps/api/src/storage/s3.ts.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (without the bucket name). Empty for Amazon S3.
S3_ENDPOINT=
S3_PREFIX=

# Extra storage in Google Drive. Used when the main storage above is full, or when a clerk, principal or admin chooses it
# on the Storage page. Leave GDRIVE_FOLDER_ID empty to keep Drive off. See SERVICES.md, section 4d.
GDRIVE_FOLDER_ID=
# Sign in with a service account (works with Google Workspace and with a normal Gmail account): paste the whole key file on ONE
# line inside single quotes, then share the Drive folder with the account's email address (Editor).
# GDRIVE_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"...","private_key":"..."}'
# ... or sign in as a person (their own storage space) instead:
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_REFRESH_TOKEN=
# When "Automatic" is chosen, new files go to Google Drive once the main storage holds this many gigabytes (Cloudflare R2's free
# allowance is 10). Empty = no limit: Drive is then used only if the main storage refuses a file.
STORAGE_PRIMARY_LIMIT_GB=

# "Connect Google Drive" on the Storage page: the Google sign-in this server offers schools. Create an OAuth client ID
# (type "Web application") in Google Cloud and add the redirect address below as an authorised redirect URI. See SERVICES.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public address of this API, used to build the redirect address (<API_PUBLIC_URL>/api/storage/drive/callback).
API_PUBLIC_URL=http://localhost:4000
