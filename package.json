{
  "name": "school-app",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @school/web --filter @school/api dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @school/db generate",
    "db:migrate": "pnpm --filter @school/db migrate",
    "db:seed": "pnpm --filter @school/db seed",
    "test": "pnpm -r --if-present test"
  }
}
